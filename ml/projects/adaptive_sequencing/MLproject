name: asiwdp-adaptive-sequencing

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      artifact_dir: {type: string, default: artifacts/adaptive_sequencing}
      n_learners: {type: int, default: 250}
      seed: {type: int, default: 42}
    command: >
      python -m asiwdp_ml.adaptive_sequencing.train
      --artifact-dir {artifact_dir}
      --n-learners {n_learners}
      --seed {seed}

  train-local:
    parameters:
      artifact_dir: {type: string, default: artifacts/adaptive_sequencing}
      n_learners: {type: int, default: 250}
    command: >
      python -m asiwdp_ml.adaptive_sequencing.train
      --artifact-dir {artifact_dir}
      --n-learners {n_learners}
      --no-register

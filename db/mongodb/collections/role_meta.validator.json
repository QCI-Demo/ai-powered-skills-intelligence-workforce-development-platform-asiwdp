{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["tenant_id", "role_id", "version"],
    "properties": {
      "_id": {
        "bsonType": ["objectId", "string"]
      },
      "tenant_id": {
        "bsonType": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        "description": "Tenant isolation key (UUID)"
      },
      "role_id": {
        "bsonType": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        "description": "References PostgreSQL role.id"
      },
      "version": {
        "bsonType": "int",
        "minimum": 1,
        "description": "Taxonomy / document revision"
      },
      "metadata": {
        "bsonType": "object",
        "description": "Optional extensible custom attributes",
        "additionalProperties": true
      },
      "tags": {
        "bsonType": "array",
        "items": { "bsonType": "string" }
      },
      "audit_entries": {
        "bsonType": "array",
        "description": "Flexible audit blobs appended for this role meta document",
        "items": {
          "bsonType": "object",
          "required": ["action", "at"],
          "properties": {
            "action": { "bsonType": "string" },
            "at": { "bsonType": "date" },
            "actor_id": { "bsonType": ["string", "null"] },
            "detail": { "bsonType": "object" }
          },
          "additionalProperties": true
        }
      },
      "created_at": { "bsonType": "date" },
      "updated_at": { "bsonType": "date" }
    },
    "additionalProperties": false
  }
}

                  "});",
                  "",
                  "pm.test('Response contains import summary with failures', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('imported_count');",
                  "    pm.expect(jsonData).to.have.property('failed_count');",
                  "    pm.expect(jsonData.failed_count).to.be.at.least(1);",
                  "});",
                  "",
                  "pm.test('Response contains error details for failures', function () {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.errors && jsonData.errors.length > 0) {",
                  "        jsonData.errors.forEach(err => {",
                  "            pm.expect(err).to.have.property('index');",

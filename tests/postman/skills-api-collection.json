      "item": [
        {
          "name": "POST /skills/bulk-import - Valid Batch",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 202', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
                  "});",
                  "",
                  "pm.test('Response contains import summary', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('imported_count');",
                  "    pm.expect(jsonData).to.have.property('failed_count');",
                  "    pm.expect(jsonData).to.have.property('total_count');",
                  "});",
                  "",
                  "pm.test('All records imported successfully', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.imported_count).to.eql(jsonData.total_count);",
                  "    pm.expect(jsonData.failed_count).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
